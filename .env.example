# 复制成 .env 再填。.env 不要提交（.gitignore 已经挡了）。
#
#     cp .env.example .env
#     . scripts/load-env.sh      # source，别执行
#     harbor run -c configs/job-deepseek-antchat-x5.yaml
#
# make 的目标会自己 source，手敲 harbor 才需要上面第二行。

# --- 模型凭证：按你要跑的 provider 填，local/ 不需要 key ---
DEEPSEEK_API_KEY=
ANTCHAT_API_KEY=
# LOCAL_API_KEY=
# LOCAL_BASE_URL=http://localhost:11434/v1

# --- 差分判分用的真实服务凭证 ---
# 只有声明了 scoring = "differential" 的题才需要。
#
# **必须是最小权限的只读子账号。** 差分判分意味着一个任意模型拿着这份凭证联网
# （那些题的 allow_internet 是 true）。给读账单的权限就只给读账单的权限。
#
# 阿里云 BSS（账单查询）：RAM 子账号 + AliyunBSSReadOnlyAccess
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
