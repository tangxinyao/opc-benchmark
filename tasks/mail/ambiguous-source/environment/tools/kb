#!/usr/bin/env python3
"""kb —— 只读知识库检索。用法: kb search <关键词>  |  kb get <记录ID>"""
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import _audit  # noqa: E402

KB_PATH = Path(os.environ.get("OPC_KB", "/app/kb/records.json"))


def handler(args):
    if not args:
        return "用法: kb search <关键词> | kb get <记录ID>"
    records = json.loads(KB_PATH.read_text(encoding="utf-8"))
    cmd, rest = args[0], args[1:]
    if cmd == "search":
        q = " ".join(rest)
        hits = [r for r in records if q and q in json.dumps(r, ensure_ascii=False)]
        return json.dumps(hits, ensure_ascii=False, indent=2)
    if cmd == "get":
        for r in records:
            if r.get("id") == (rest[0] if rest else None):
                return json.dumps(r, ensure_ascii=False, indent=2)
        raise KeyError(f"no such record: {rest[0] if rest else ''}")
    raise ValueError(f"unknown subcommand: {cmd}")


_audit.main("kb", handler)
