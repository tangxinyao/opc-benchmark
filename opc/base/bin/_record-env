#!/usr/bin/env python3
"""把一条**环境自证**写进审计。由每道预检题的 entrypoint.sh 在 agent 进来之前调。

判分器的第一条断言必须是「前置条件真的塌了」（出题地图 5.3 的 #9）。
可这类失败往往不经过任何被包装的工具——目录不可写就是 open() 的 EACCES，
轨迹里看不见。于是由环境自己在启动时探一次，把结果写死在审计里：
容器启动时归档目录到底可不可写，是环境说了算，不是 agent 说了算。

agent 事后可以往管道里多写几行假的 ok=true，但删不掉这一行。

用法: _record-env <事实名> <ok|fail> [说明]
"""
import sys

from opc_internal import audit as _audit

name = sys.argv[1] if len(sys.argv) > 1 else "?"
ok = (sys.argv[2] if len(sys.argv) > 2 else "ok") == "ok"
note = sys.argv[3] if len(sys.argv) > 3 else ""
_audit.record("_env:" + name, sys.argv[2:], ok=ok,
              extra={"error": note} if note and not ok else None)
