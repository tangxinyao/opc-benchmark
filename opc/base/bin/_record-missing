#!/usr/bin/env python3
"""把一次「命令不存在」写进审计。由 /opt/opc/bashenv.sh 的 command_not_found_handle 调。

为什么需要它：判分器只看产物和审计日志。agent 敲了 `git log` 撞上 127，
这件事本身不经过任何被包装的工具，轨迹里一个字都没有——
于是「它探测过吗」和「它压根没试就开始编」在日志上长得一模一样。
"""
import sys

from opc_internal import audit as _audit

cmd = sys.argv[1] if len(sys.argv) > 1 else "?"
_audit.record(
    "missing:" + cmd,
    sys.argv[1:],
    ok=False,
    extra={"error": "{0}: command not found".format(cmd)},
)
