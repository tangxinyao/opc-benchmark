#!/bin/sh
# 构建时调用（放在语料 COPY 之后）：把「后端语料不存在」的只读工具从 PATH 上摘掉。
#
# opc/base/bin/ 是烘进基础镜像、每道题都有的，但只读工具的全部意义就是读它那份语料。
# 语料不在，留着就是一条一跑就 FileNotFoundError 的死命令：agent 会花预算去试，
# 试完还得自己推断「这条路不通」，判分时又多一段要解释的轨迹。
#
# 不可逆动作的工具（himalaya / stripe）不在此列：它们是真 CLI，装在基础镜像里，
# 语料也不在 /app 下，而是各自的 fixture 服务端在供。见 docs/todo-no-preflight.md
# 的「哑命令为什么删掉了」。
#
# 这个脚本最后会把自己也删掉：它是构建期的东西，跑完就没有存在的理由了。
# （它本身在 /usr/local/bin，本来就不在 agent 会去翻的 /opt/opc/bin 里。）
set -eu
BIN=/opt/opc/bin

prune() {  # prune <工具名> <它必需的语料路径>
  if [ ! -e "$2" ]; then
    rm -f "$BIN/$1"
    echo "prune: 摘掉 $1（缺 $2）"
  fi
}

prune rules "${OPC_RULES:-/app/rules/platform_rules.json}"

rm -f /usr/local/bin/opc-prune-tools
